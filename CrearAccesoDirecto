#!/usr/bin/env bash
set -euo pipefail

directorio="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
archivo="$directorio/PescaAuto.desktop"
ejecutable="$directorio/IniciarPescaAuto"
icono="$directorio/pescaauto/assets/pescaauto.png"

if [[ -x "$directorio/PescaAuto" ]]; then
    ejecutable="$directorio/PescaAuto"
    icono="$directorio/PescaAuto.png"
fi

if [[ "$directorio" == *'"'* || "$directorio" == *'\\'* || "$directorio" == *$'\n'* ]]; then
    echo "La ruta contiene caracteres que no admite este generador de accesos directos." >&2
    exit 1
fi

cat > "$archivo" <<EOF
[Desktop Entry]
Type=Application
Name=PescaAuto
Comment=Pesca automática para WoW 3.3.5a con ventana de control
Exec="$ejecutable"
Path=$directorio
Icon=$icono
Terminal=false
Categories=Game;
StartupNotify=false
EOF

chmod +x "$archivo"
echo "Acceso directo creado en $archivo"
